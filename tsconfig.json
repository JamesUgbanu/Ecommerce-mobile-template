{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "jsx": "react-native",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext"
  },
  "include": ["App.tsx", "src"],
  "exclude": [
    "node_modules",
    "src/store",
    "src/screens/CropPhotoScreen",
    "src/screens/SearchPhotoScreen"
  ]
}
